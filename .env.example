# Google Analytics Measurement ID
# Get this from Google Analytics: Admin > Data Streams > Web > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console Verification
# Get this from Google Search Console: Settings > Ownership verification > HTML tag
# Copy only the content value (not the full meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Facebook Pixel ID
# Get this from Facebook Events Manager: Data Sources > Your Pixel > Settings
NEXT_PUBLIC_FB_PIXEL_ID=XXXXXXXXXXXXXXX

# Microsoft Clarity Project ID
# Get this from Clarity: Settings > Overview > Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=xxxxxxxxxx
